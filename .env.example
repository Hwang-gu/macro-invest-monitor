# 선택. 없으면 규칙 기반 해설만 생성합니다.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 선택. 한국은행 ECOS 인증키. 있으면 기준금리를 일별로 받습니다.
# 발급: https://ecos.bok.or.kr/api/ → 회원가입 → 인증키 신청 (무료, 보통 즉시)
# 키가 없으면 FRED 월간 한은 기준금리(OECD)를 씁니다.
BOK_API_KEY=

# 웹앱 로그인 (GitHub Pages는 공개라 완벽한 보안은 아닙니다. 비밀번호는 배포 시 해시만 들어갑니다.)
TED_MANAGER_ID=ted
TED_MANAGER_PW=TedInvest25!
TED_USER_ID=user
TED_USER_PW=TedUser25!

# 선택. 로컬에서 User 계정을 만들면 GitHub data/ted_users.json 에 올라갑니다.
# 이 값은 .env 에만 넣으세요. GitHub에 커밋하거나 공개 페이지에 넣지 마세요.
TED_SYNC_TOKEN=

# 매일 브리핑 메일. Gmail은 앱 비밀번호를 씁니다.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
